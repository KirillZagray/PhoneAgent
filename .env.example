# ─── App ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── State store (сессии диалогов) ────────────────────
# memory — для локальной разработки/тестов без Redis. redis — для прод
# (docker-compose выставляет redis принудительно).
STATE_STORE=memory
REDIS_URL=redis://localhost:6379/0
STATE_TTL_SECONDS=3600

# ─── Telephony Provider ──────────────────────────────
# Доступные: mock | voximplant | twilio | asterisk
# Реальные провайдеры пока не умеют стримить аудио — /call/request-callback
# с ними откажет (400). См. Roadmap.
TELEPHONY_PROVIDER=mock
PUBLIC_WEBHOOK_BASE_URL=http://localhost:8000

# Voximplant
VOXIMPLANT_ACCOUNT_ID=
VOXIMPLANT_API_KEY=
VOXIMPLANT_RULE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=

# Asterisk (self-hosted)
ASTERISK_HOST=
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=

# ─── STT Provider ─────────────────────────────────────
# Доступные: mock | whisper_api | faster_whisper | voicestudio
# faster_whisper требует `uv sync --extra local-stt`.
STT_PROVIDER=mock
OPENAI_API_KEY=

# ─── TTS Provider ─────────────────────────────────────
# Доступные: mock | edge_tts | voicestudio | elevenlabs
TTS_PROVIDER=mock
# VoiceStudio (https://github.com/debpalash/VoiceStudio) — один локальный сервер
# и для TTS (POST /v1/audio/speech), и для STT (POST /v1/audio/transcriptions,
# Whisper-семейство ASR под капотом). Один и тот же URL для TTS_PROVIDER=voicestudio
# и STT_PROVIDER=voicestudio. Дефолтный порт из докера VoiceStudio — 3900.
# См. examples/voicestudio_setup.md — в т.ч. про лицензии моделей.
VOICESTUDIO_URL=http://localhost:3900
VOICESTUDIO_VOICE_ID=ru_female_01
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── LLM Provider ─────────────────────────────────────
# Доступные: anthropic | openai | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Таймаут одного запроса к LLM/STT API. В звонке зависание = тишина в трубке.
LLM_TIMEOUT_SECONDS=15
# Сколько последних реплик отдавать модели.
MAX_HISTORY_MESSAGES=40

# ─── Booking / салон ─────────────────────────────────
# Доступные коннекторы: mock | generic_api (yclients/dikidi/altegio — в планах)
# v1: один деплой = один салон. salon_id в API принимается, но ничего не выбирает.
BOOKING_CONNECTOR=mock
BOOKING_API_URL=
BOOKING_API_TOKEN=
SALON_ID=demo
# Попадают в системный промпт — модель должна знать, кто она и когда салон открыт.
SALON_NAME=салон красоты
SALON_TIMEZONE=Europe/Moscow
SALON_WORKING_HOURS=10:00-20:00

# ─── Voice Pipeline ──────────────────────────────────
# Частота PCM между TTS и телефонией (телефонная линия — 8000).
SAMPLE_RATE=8000

# ─── Conversation ─────────────────────────────────────
DEFAULT_LANGUAGE=ru
# Жёсткий потолок длительности звонка.
CALL_TIMEOUT_SECONDS=300
MAX_RETRIES=3
# Повторный «Перезвонить» на тот же номер в это окно → 409.
CALLBACK_DEDUPE_SECONDS=120

# ─── Security ──────────────────────────────────────────
# В APP_ENV=production приложение НЕ СТАРТУЕТ без обоих значений.
# В development пустые значения = проверка отключена.
# API_AUTH_TOKEN: Bearer-токен, который бэкенд сайта салона шлёт в /call/* и /admin/config.
#   Server-to-server: в браузерный JS его класть нельзя.
# WEBHOOK_SECRET: значение заголовка X-Webhook-Secret, которое ваш прокси/провайдер
#   должен добавлять к вебхукам (см. examples/*_setup.md).
API_AUTH_TOKEN=
WEBHOOK_SECRET=
