# ─── App ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=PhoneAgent

# ─── State store (сессии диалогов) ────────────────────
# memory — для локальной разработки/тестов без Redis. redis — для прод.
STATE_STORE=memory
REDIS_URL=redis://localhost:6379/0

# ─── Telephony Provider ──────────────────────────────
# Доступные: mock | voximplant | twilio | asterisk
TELEPHONY_PROVIDER=mock
PUBLIC_WEBHOOK_BASE_URL=http://localhost:8000

# Voximplant
VOXIMPLANT_ACCOUNT_ID=
VOXIMPLANT_API_KEY=
VOXIMPLANT_RULE_ID=
VOXIMPLANT_SCENARIO_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=

# Asterisk (self-hosted)
ASTERISK_HOST=
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=

# ─── STT Provider ─────────────────────────────────────
# Доступные: mock | whisper_api | faster_whisper | voicestudio
STT_PROVIDER=mock
OPENAI_API_KEY=

# ─── TTS Provider ─────────────────────────────────────
# Доступные: mock | edge_tts | voicestudio | elevenlabs
TTS_PROVIDER=mock
# VoiceStudio (https://github.com/debpalash/VoiceStudio) — один локальный сервер
# и для TTS (POST /v1/audio/speech), и для STT (POST /v1/audio/transcriptions,
# Whisper-семейство ASR под капотом). Один и тот же URL для TTS_PROVIDER=voicestudio
# и STT_PROVIDER=voicestudio. Дефолтный порт из докера VoiceStudio — 3900.
VOICESTUDIO_URL=http://localhost:3900
VOICESTUDIO_VOICE_ID=ru_female_01
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── LLM Provider ─────────────────────────────────────
# Доступные: anthropic | openai | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ─── Booking Connector ────────────────────────────────
# Доступные: mock | generic_api | yclients | dikidi | altegio
BOOKING_CONNECTOR=mock
BOOKING_API_URL=
BOOKING_API_TOKEN=
SALON_ID=demo

# ─── Voice Pipeline ──────────────────────────────────
SAMPLE_RATE=8000
AUDIO_CHANNELS=1
AUDIO_FORMAT=ulaw

# ─── Conversation ─────────────────────────────────────
DEFAULT_LANGUAGE=ru
CALL_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# ─── Security ──────────────────────────────────────────
# Обязательно задать в production — иначе /call/* и /webhooks/* открыты всем.
# API_AUTH_TOKEN: Bearer-токен, который сайт салона шлёт в /call/request-callback.
# WEBHOOK_SECRET: значение заголовка X-Webhook-Secret, которое ваш прокси/провайдер
#   должен добавлять к вебхукам (см. examples/*_setup.md).
API_AUTH_TOKEN=
WEBHOOK_SECRET=
